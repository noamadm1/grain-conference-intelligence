# העתק לקובץ .env ומלא את הערכים (Supabase → Project Settings → API)

# נחשף לדפדפן (Vite מכניס לבאנדל רק משתנים עם קידומת VITE_)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# לסקריפט הטעינה בלבד — לעולם לא עם קידומת VITE_, לעולם לא ב-git.
# עוקף RLS. אם ריק, הסקריפט ינסה עם ה-anon key (יעבוד רק אם RLS מתיר insert).
SUPABASE_SERVICE_ROLE_KEY=
